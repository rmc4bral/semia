# Acopia · Hostinger (Apache/LiteSpeed)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Proteger la base de datos y respaldos
<FilesMatch "^(data\.json|data\.seed\.json|.*\.bak|.*\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/?(.*/)?(backups|datos)/

# Forzar HTTPS (necesario para GPS y cámara en el celular)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # fotos y mapas ahora viven fuera de la web: los enlaces viejos pasan por la API
  RewriteRule ^uploads/(.+)$ api.php?action=file&p=$1 [L,QSA]
  # landing en /; la app en /login y /dashboard/<menú> (siempre app.html)
  RewriteRule ^(login|dashboard)(/.*)?$ app.html [L]
  # páginas legales con dirección limpia (/privacidad, /terminos, /cookies)
  RewriteRule ^(privacidad|terminos|cookies)/?$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self)"
  <FilesMatch "\.(js|css|html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # fuentes, íconos e imágenes de la landing: no cambian de nombre, se guardan un año
  <FilesMatch "\.(woff2|png|svg|webp|avif|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# SemIA · el Git de Hostinger deja el repo en la raíz del dominio:
# todo el tráfico se sirve desde la carpeta public_html/ del repo.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{REQUEST_URI} !^/public_html/
RewriteRule ^(.*)$ public_html/$1 [L]
# nada del código fuente es accesible
RedirectMatch 404 ^/(src|tests|tools|node_modules|\.github|\.git)(/|$)
<FilesMatch "^(package(-lock)?\.json|build\.mjs|README\.md)$">
  Require all denied
</FilesMatch>
